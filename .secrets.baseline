      "path": "detect_secrets.filters.regex.should_exclude_file",
      "pattern": [
        "data/.*",
        "\\.venv/.*",
        "\\.git/.*",
        ".*__pycache__.*",
        "\\.pytest_cache/.*",
        "\\.ruff_cache/.*",
        "\\.secrets\\.baseline"
      ]
    }
